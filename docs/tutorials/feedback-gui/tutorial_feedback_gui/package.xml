<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tutorial_feedback_gui</name>
  <version>0.1.0</version>
  <description>Tutorial: a window with a bar that follows the band power of one channel (Python, tkinter).</description>
  <maintainer email="paolo.forin@phd.unipd.it">Paolo Forin</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tutorial_band_power</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
