<launch>
    <!-- Filter bank CSP, from a GDF replay (no hardware) to the bars:

             acquisition -> fbcsp (filter bank + CSP + log-variance) -> decoder (LDA) -> integrator -> control -> feedback (bars)

         The fbcsp node and the model (config/fbcsp.yaml, model/) come from train_fbcsp.m; the integrator, control, manager and feedback are
         the ones of the ros2neuro_devel_test launchers (same two classes, BOTH_HANDS 773 and BOTH_FEET 771).

         Usage:
             ros2 launch tutorial_fbcsp fbcsp_bars.launch.xml protocol:=evaluation
             ros2 launch tutorial_fbcsp fbcsp_bars.launch.xml protocol:=control
    -->
    <arg name="protocol" default="evaluation" description="calibration | evaluation | control"/>
    <arg name="gdf_file" default="$(find-pkg-share ros2neuro_devel_test)/extra/test_mi.gdf" description="EEG file to replay"/>

    <let name="config" value="$(find-pkg-share tutorial_fbcsp)/config"/>
    <let name="devel" value="$(find-pkg-share ros2neuro_devel_test)/launch/gaussian/config"/>
    <let name="decoder_manifest" value="$(find-pkg-share tutorial_fbcsp)/model/manifest.yaml"/>

    <node pkg="ros2neuro_acquisition" exec="acquisition" name="acquisition" output="screen">
        <param from="$(var config)/pipeline.yaml" allow_substs="true"/>
    </node>

    <node pkg="tutorial_fbcsp" exec="fbcsp_node" name="fbcsp" output="screen">
        <param from="$(var config)/fbcsp.yaml"/>
        <remap from="/neurodata" to="/acquisition/neurodata"/>
        <remap from="/features" to="/processing/fbcsp"/>
    </node>

    <node pkg="ros2neuro_decoder" exec="decoder_node" name="decoder" output="screen">
        <param from="$(var config)/pipeline.yaml" allow_substs="true"/>
        <remap from="/features" to="/processing/fbcsp"/>
        <remap from="~/prediction" to="/classification/prediction"/>
    </node>

    <node pkg="ros2neuro_integrator" exec="integrator_node" name="integrator" output="screen">
        <param from="$(var devel)/integrator_exponential.yaml"/>
    </node>

    <node pkg="ros2neuro_control" exec="control_node" name="control" output="screen" on_exit="shutdown">
        <param from="$(var devel)/layout.yaml"/>
        <param from="$(var devel)/protocol_$(var protocol).yaml"/>
    </node>

    <node pkg="ros2neuro_manager" exec="manager_node" name="manager" output="screen" on_exit="shutdown">
        <param from="$(var devel)/layout.yaml"/>
        <param from="$(var devel)/protocol_$(var protocol).yaml"/>
    </node>

    <node pkg="ros2neuro_feedback" exec="feedback_node" name="feedback" output="screen">
        <param from="$(var devel)/layout.yaml"/>
        <param from="$(var devel)/feedback_bars.yaml"/>
    </node>
</launch>
