<launch>
    <!-- The robot side of the stack: the robot control (a second control node, next to the one of ros2neuro_control_feedback), the
         synchronization with the flow of the feedback, and the robot. Start it next to a pipeline that has the feedback, for example
             ros2 launch ros2neuro_devel_test test_feedback_wheel.launch.xml protocol:=control
         (in control and evaluation the flow carries the values of the integrator, with the header of the prediction). -->
    <let name="config" value="$(find-pkg-share tutorial_robot_control)/config/robot_control.yaml"/>

    <node pkg="ros2neuro_control" exec="control_node" name="control_robot" output="screen">
        <param from="$(var config)"/>
    </node>
    <node pkg="tutorial_robot_control" exec="sync_node" name="sync" output="screen">
        <param from="$(var config)"/>
    </node>
    <node pkg="tutorial_robot_control" exec="fake_robot_node" name="robot" output="screen">
        <param from="$(var config)"/>
    </node>
</launch>
