<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tutorial_filter_plugin</name>
  <version>0.1.0</version>
  <description>Tutorial: a ros2neuro filter plugin that clips the signal to a symmetric range.</description>
  <maintainer email="paolo.forin@phd.unipd.it">Paolo Forin</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>ros2neuro_filters</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
